{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Begin synthetic task result body",
  "description": "Structural begin-task-result-v1 body for the fixed synthetic interval-intersection operation. Request/grant hashes, expected signer, response audience, provenance and ciphertext binding need runtime verification; this schema is not computation proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "request_digest",
    "status",
    "sealed_digest",
    "provenance",
    "grant_digests"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "const": "begin-task-result-v1"
    },
    "request_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "sealed_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "resource_revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "synthetic-calculation"
        },
        "method": {
          "type": "string",
          "const": "interval-intersection-v1"
        },
        "resource_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "grant_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
