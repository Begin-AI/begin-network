# Operator-only configuration. Participants use their existing client and a browser sign-in.
BEGIN_ORIGIN=https://discovery.example.com
BEGIN_DATABASE=/data/begin.sqlite
BETTER_AUTH_SECRET=
# Closed pilot: only these accounts can register. Empty means no new registrations.
BEGIN_ALLOWED_EMAILS=
PORT=8080
# Set only for loopback tests; never on a remotely reachable deployment.
BEGIN_LOCAL_TEST=0

# Operator registers the exact /api/auth/callback/google URL for this host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
