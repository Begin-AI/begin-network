{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Begin JWS v1 decoded payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "sender",
    "id",
    "audience",
    "issued_at",
    "expires_at",
    "body",
    "proofs"
  ],
  "properties": {
    "version": {
      "const": "0.1-draft"
    },
    "type": {
      "enum": [
        "request",
        "response",
        "grant",
        "revocation"
      ]
    },
    "sender": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "integer"
    },
    "expires_at": {
      "type": "integer"
    },
    "body": {
      "type": "object"
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
