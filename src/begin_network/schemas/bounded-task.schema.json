{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Begin bounded task body",
  "description": "Structural body contract only. Signatures, authority, budgets, routing paths, time and sealed-content binding require runtime verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "purpose",
    "action",
    "resource",
    "units"
  ],
  "properties": {
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "sealed_digest": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress",
        "hop_limit"
      ],
      "properties": {
        "ingress": {
          "type": "string",
          "minLength": 1
        },
        "hop_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  }
}
