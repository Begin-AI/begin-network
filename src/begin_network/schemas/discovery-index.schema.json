{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Begin public discovery index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "generated_at",
    "status",
    "schemas",
    "methods",
    "nodes"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1-draft"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "experimental"
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^schemas/[a-z0-9.-]+\\.json$"
      },
      "uniqueItems": true
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "purpose",
          "privacy",
          "implemented",
          "method_version",
          "model",
          "dimensions",
          "normalization",
          "availability",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./-]{0,127}$"
          },
          "status": {
            "enum": [
              "proposed",
              "experimental",
              "evaluated"
            ]
          },
          "purpose": {
            "type": "string",
            "maxLength": 500
          },
          "privacy": {
            "enum": [
              "synthetic-only",
              "specified-not-validated",
              "evaluated-under-stated-assumptions"
            ]
          },
          "implemented": {
            "type": "boolean"
          },
          "method_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "dimensions": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              {
                "const": "dynamic"
              }
            ]
          },
          "normalization": {
            "enum": [
              "binary-cosine",
              "l2",
              "per-session"
            ]
          },
          "availability": {
            "enum": [
              "runtime",
              "experiment"
            ]
          },
          "implementation": {
            "type": "string",
            "pattern": "^(src|experiments)/[A-Za-z0-9_./-]+\\.py$"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "endpoint",
          "capabilities",
          "expires_at",
          "trust"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "discovery",
                "mailbox",
                "coordination"
              ]
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "trust": {
            "const": "unverified-advertisement"
          }
        }
      }
    }
  }
}
